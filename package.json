{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained Windows desktop shell for DeepSeek Harness",
  "homepage": "https://github.com/Tlenzer/deepseek-harness-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tlenzer/deepseek-harness-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Tlenzer/deepseek-harness-desktop/issues"
  },
  "main": "src/main.js",
  "author": "Tlenzer and contributors",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "check": "node --check src/main.js && node --check src/harness-runtime.js && node --check src/dsh-runner.mjs && node --check electron-builder.config.cjs",
    "licenses": "node scripts/generate-third-party-notices.cjs",
    "runtime:install": "npm --prefix runtime ci --omit=dev --no-audit --no-fund",
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir --config electron-builder.config.cjs",
    "dist": "electron-builder --win nsis --x64 --config electron-builder.config.cjs"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.15.7"
  }
}
